# 本地脚手架无需模型密钥或音乐工具即可启动。
APP_NAME=AI 写词与作曲
# 相对项目根目录；存放数据库 app.db 与各任务目录 jobs/<任务ID>/。
RUNTIME_DIR=runtime
# 只保留最近多少个已结束任务的音频等文件，更早的由 worker 自动删除；0 表示不清理。
JOB_RETENTION=50
# 文本模型：openai_compatible（DeepSeek、通义千问兼容模式、Kimi、智谱、OpenAI 等）或 mock（离线演示模型）。
# DeepSeek V4.1 Flash：MODEL_API_URL=https://api.deepseek.com  MODEL_NAME=deepseek-flash
# 密钥只保存在后端 .env，不会出现在前端代码或接口响应中。
MODEL_PROVIDER=openai_compatible
MODEL_API_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_TIMEOUT_SECONDS=60
# 服务不支持 response_format 的 JSON 模式时改为 false。
MODEL_JSON_MODE=true
# 音频工具与钢琴音源；相对路径以项目根目录为基准，由 scripts/setup_audio.sh 安装。
FLUIDSYNTH_PATH=tools/env/bin/fluidsynth
FFMPEG_PATH=tools/env/bin/ffmpeg
SOUNDFONT_PATH=tools/soundfonts/GeneralUser-GS.sf2
